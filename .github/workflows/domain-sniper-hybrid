name: Domain Sniper Institutional

on:
  schedule:
    - cron: "30 2 * * *"   # 8:00 AM IST daily
  workflow_dispatch:

env:
  TELEGRAM_TOKEN: ${{ secrets.TELEGRAM_TOKEN }}
  TELEGRAM_CHAT_ID: ${{ secrets.TELEGRAM_CHAT_ID }}
  GOOGLE_CREDS_JSON: ${{ secrets.GOOGLE_CREDS_JSON }}
  GOOGLE_SHEET_ID: ${{ secrets.GOOGLE_SHEET_ID }}
  SHEET_NAME: "DomainSniperHybrid"
  MIN_ALERT_SCORE: "68"
  DB_PATH: "domain_sniper_institutional.db"
  MAX_WORKERS: "4"
  KELLY_BANKROLL: "10000"
  REDDIT_CLIENT_ID: ${{ secrets.REDDIT_CLIENT_ID }}
  REDDIT_CLIENT_SECRET: ${{ secrets.REDDIT_CLIENT_SECRET }}

jobs:
  snipe:
    runs-on: ubuntu-latest
    timeout-minutes: 60
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: "3.11"
      - name: Cache pip
        uses: actions/cache@v4
        with:
          path: ~/.cache/pip
          key: pip-${{ runner.os }}-${{ hashFiles('requirements.txt') }}
      - name: Restore DB
        uses: actions/cache@v4
        with:
          path: domain_sniper_institutional.db
          key: domain-db-persistent
      - name: Install dependencies
        run: pip install requests pandas feedparser beautifulsoup4 praw vaderSentiment gspread google-auth
      - name: Run sniper
        run: python domain_sniper_production.py
      - name: Upload CSV
        uses: actions/upload-artifact@v4
        with:
          name: domain-sniper-output
          path: institutional_output_*.csv
      - name: Save DB
        uses: actions/cache@v4
        with:
          path: domain_sniper_institutional.db
          key: domain-db-persistent
